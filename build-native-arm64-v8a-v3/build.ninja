build core/libcore.a: CXX_STATIC_LIBRARY_LINKER__core_ core/CMakeFiles/core.dir/src/context.cpp.o core/CMakeFiles/core.dir/src/elf_util.cpp.o core/CMakeFiles/core.dir/src/native_api.cpp.o core/CMakeFiles/core.dir/src/symbol_cache.cpp.o core/CMakeFiles/core.dir/src/jni/dex_parser.cpp.o core/CMakeFiles/core.dir/src/jni/hook_bridge.cpp.o core/CMakeFiles/core.dir/src/jni/native_api.cpp.o core/CMakeFiles/core.dir/src/jni/resources_hook.cpp.o || core/external/dobby/libdobby.a core/external/libcxx.a core/external/lsplant/lsplant/src/main/jni/external/dex_builder/libdex_builder_static.a core/external/lsplant/lsplant/src/main/jni/liblsplant_static.a
  LANGUAGE_COMPILE_FLAGS = -g -DANDROID -fdata-sections -ffunction-sections -funwind-tables -fstack-protector-strong -no-canonical-prefixes -D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security  -std=c++20
  OBJECT_DIR = core/CMakeFiles/core.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = core/CMakeFiles/core.dir/core.pdb
  TARGET_FILE = core/libcore.a
  TARGET_PDB = core/libcore.pdb


#############################################
# Utility command for edit_cache

build core/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build-native-arm64-v8a-v3/core && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build core/edit_cache: phony core/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build core/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build-native-arm64-v8a-v3/core && /usr/bin/cmake --regenerate-during-build -S/workspace/patch-loader/src/main/jni -B/workspace/build-native-arm64-v8a-v3
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build core/rebuild_cache: phony core/CMakeFiles/rebuild_cache.util

