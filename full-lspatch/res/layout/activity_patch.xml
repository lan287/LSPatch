<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="修补 APK"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="就绪 - 请选择目标 APK 和模块"
            android:textSize="13sp"
            android:textColor="#757575"
            android:paddingBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="目标应用 APK"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/tvTargetFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(未选择)"
                android:textSize="13sp"
                android:textColor="#757575"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnSelectTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择 APK"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="要嵌入的 Xposed 模块"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/tvModuleList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(未选择)"
                android:textSize="13sp"
                android:textColor="#757575"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnAddModule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="添加模块 APK"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选项"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <CheckBox
                android:id="@+id/cbDebuggable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设置为 debuggable (便于调试)"
                android:textSize="14sp"/>

            <CheckBox
                android:id="@+id/cbOverrideVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="覆盖版本号 (允许降级安装)"
                android:textSize="14sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnStartPatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始修补"
            android:textStyle="bold"
            android:textSize="17sp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal"
            android:indeterminate="true"
            android:paddingTop="12dp"/>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#212121"
            android:paddingTop="12dp"
            android:typeface="monospace"/>
    </LinearLayout>
</ScrollView>
